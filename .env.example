# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL do seu projeto Supabase (ex: https://flnytwosxztpzkzxjjia.supabase.co)
SUPABASE_URL="https://flnytwosxztpzkzxjjia.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Chave secreta de serviço do Supabase (NUNCA expor no frontend).
# Usada exclusivamente no servidor pela rota temporária de migração /api/admin/migrate-images.
SUPABASE_SERVICE_ROLE_KEY=""

# MIGRATION_PASSWORD: Senha temporária para autorizar a execução da simulação e migração de imagens.
MIGRATION_PASSWORD=""

# ADMIN_PASSWORD: Senha administrativa para o Painel Admin e upload seguro de imagens no Storage.
# Se não definida, o servidor aceitará MIGRATION_PASSWORD ou a senha padrão 149610.
ADMIN_PASSWORD=""
